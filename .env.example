# --- KI-Analyse -------------------------------------------------------------
# Google Gemini API Key. Ohne diesen Key läuft die Seite im Demo-Modus und
# liefert nur eine gekennzeichnete Beispiel-Ausgabe statt einer echten Analyse.
# Key erstellen: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# --- Abo / Zahlung ----------------------------------------------------------
# Stripe Secret Key (sk_live_... bzw. sk_test_...).
# Fehlt er, ist der Checkout im Demo-Modus und schaltet nichts kostenpflichtig frei.
STRIPE_SECRET_KEY=""

# Preis-IDs der beiden Abos aus dem Stripe-Dashboard (price_...).
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""

# --- Deployment -------------------------------------------------------------
# Öffentliche URL der Seite, wird für die Stripe-Rücksprünge gebraucht.
APP_URL="http://localhost:3000"

# Port des Servers (Standard 3000).
PORT="3000"
